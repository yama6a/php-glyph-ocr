{
  // The schedule is the cron in .github/workflows/renovate.yaml, so workflow_dispatch works too.
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>yama6a/gha:default.json5", "github>yama6a/gha:php.json5"],

  // ci.yaml fails a PR without a release label. A dependency bump never changes the public API.
  labels: ["patch"],

  // The harness that wrote tests/fixtures/subtitle-edit/expected.txt keeps the SkiaSharp version it ran with.
  ignorePaths: ["tests/fixtures/subtitle-edit/**"],

  packageRules: [
    {
      // PHPUnit 12 needs PHP 8.3 and PHPUnit 13 needs PHP 8.4.1, but composer.json still allows PHP 8.2.
      // When PHP 8.2 support goes (December 2026), raise this to "<13".
      // When PHP 8.3 support goes (December 2027), delete this rule.
      description: "hold PHPUnit below 12 while PHP 8.2 is supported",
      matchPackageNames: ["phpunit/phpunit"],
      allowedVersions: "<12",
    },
  ],
}
